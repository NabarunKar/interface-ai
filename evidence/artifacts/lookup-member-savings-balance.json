{
  "id": "lookup-member-savings-balance",
  "name": "Lookup Member Savings Balance",
  "description": "Find member 10234 and return their current savings balance",
  "version": "1.0.0",
  "targetApp": "bank-ops",
  "surfaceType": "web",
  "entryPoint": "http://localhost:3100/",
  "inputs": [
    {
      "name": "memberId",
      "description": "The memberId to look up",
      "type": "string",
      "required": true,
      "example": "10234"
    }
  ],
  "steps": [
    {
      "index": 0,
      "action": {
        "type": "type",
        "target": {
          "strategy": "label",
          "value": "Member ID:"
        },
        "value": "{{memberId}}"
      },
      "rationale": "Type the member ID into the search field"
    },
    {
      "index": 1,
      "action": {
        "type": "click",
        "target": {
          "strategy": "text",
          "value": "SEARCH"
        }
      },
      "postcondition": {
        "description": "Navigated to member profile or error page",
        "condition": "url_matches",
        "expectedValue": "/member"
      },
      "rationale": "Submit the search"
    },
    {
      "index": 2,
      "action": {
        "type": "click",
        "target": {
          "strategy": "text",
          "value": "[ View Accounts ]"
        }
      },
      "postcondition": {
        "description": "Navigated to accounts page",
        "condition": "url_matches",
        "expectedValue": "/accounts"
      },
      "rationale": "Navigate to accounts"
    }
  ],
  "outputs": [
    {
      "name": "savingsBalance",
      "description": "Extracted savingsBalance",
      "source": {
        "strategy": "css",
        "value": "tr:nth-child(3) td:nth-child(3)"
      },
      "type": "string"
    }
  ],
  "successCondition": {
    "description": "Accounts page is displayed with savings balance",
    "condition": "page_contains_text",
    "expectedValue": "Savings"
  },
  "expectedBusinessOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "Member not found in database",
      "checkpoint": {
        "description": "Page displays not found message",
        "condition": "page_contains_text",
        "expectedValue": "No member found"
      }
    }
  ],
  "policyConstraints": {
    "allowedDomains": [
      "localhost",
      "127.0.0.1"
    ],
    "readOnly": true,
    "maxDurationMs": 30000
  },
  "createdAt": "2026-09-19T01:20:01.813Z",
  "updatedAt": "2026-09-19T01:20:01.813Z",
  "sourceRunId": "discovery-1789780799807"
}
